# Local development only. Production values live outside the repository.
DATABASE_URL=postgres://ktr3:ktr3_local_only@127.0.0.1:54329/ktr3_underground
DATABASE_MAX_CONNECTIONS=5
ANALYTICS_HASH_SECRET=replace-with-at-least-32-random-bytes
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
APP_ORIGIN=https://ktr3.es,https://www.ktr3.es
TURNSTILE_ENFORCE=false

# PostHog Cloud EU (the phc_ project token is public by design; never use a Personal API Key here)
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Public Blaze Player URL copied from BeatStars Studio → Features → Players.
# Example: https://player.beatstars.com/?storeId=12345
BEATSTARS_PLAYER_URL=

# Producer resource library
RESOURCE_STORAGE_DRIVER=local
RESOURCE_STORAGE_PATH=.data/resources
RESOURCE_MAX_UPLOAD_BYTES=262144000
ADMIN_RATE_LIMIT_SECRET=replace-with-at-least-32-random-bytes
RESOURCE_RATE_LIMIT_SECRET=replace-with-a-different-32-byte-random-secret
RESOURCE_EMAIL_LIMIT_PER_HOUR=5
RESOURCE_IP_LIMIT_PER_HOUR=10
RESOURCE_IP_LIMIT_PER_DAY=30
RESOURCE_GLOBAL_LIMIT_PER_DAY=90
EMAIL_DRIVER=development
# Sending-only key restricted to ktr3.es
RESEND_API_KEY=
# Full-access key used only for confirmed newsletter contacts
RESEND_CONTACTS_API_KEY=
RESEND_SEGMENT_ID=
EMAIL_FROM="Ktr3 Resources <resources@ktr3.es>"

# Public legal identity. Keep real values outside Git and configure them on the server.
PUBLIC_LEGAL_NAME=
PUBLIC_LEGAL_TAX_ID=
PUBLIC_LEGAL_ADDRESS=
PUBLIC_LEGAL_EMAIL=prod.ktr3@gmail.com

# Cloudflare R2 (only required when RESOURCE_STORAGE_DRIVER=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ktr3-resources
