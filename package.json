{
  "name": "ktr3-links",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start",
    "test": "node --test tests/*.test.js",
    "db:start": "docker compose -f docker-compose.dev.yml up -d --wait --wait-timeout 60 database",
    "db:stop": "docker compose -f docker-compose.dev.yml down",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:import:current": "node scripts/import-current-catalog.mjs",
    "db:import:survey": "node scripts/import-underground-survey.mjs",
    "db:import:catalog-update": "node scripts/import-underground-catalog-update.mjs"
  },
  "dependencies": {
    "next": "^16.2.10",
    "postgres": "^3.4.9",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.4.3"
  },
  "overrides": {
    "postcss": "8.5.19"
  }
}
